# Server
PORT=4000
NODE_ENV=development

# PostgreSQL (use Docker Compose default or your own instance)
DATABASE_URL=postgresql://doctor_tracker:doctor_tracker@localhost:5432/doctor_tracker?schema=public

# Session
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=24

# CORS — frontend origin (Next.js dev server)
CORS_ORIGIN=http://localhost:3000

# Seed / demo admin (used by prisma/seed.ts — set only when running seed, not in Vercel production)
SEED_ADMIN_EMAIL=test@gmail.com
# SEED_ADMIN_PASSWORD=set-at-seed-time-only
