{
  "name": "backend-interview",
  "version": "1.0.0",
  "description": "Doctor Tracker REST API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node init && tsx watch src/index.ts",
    "build": "node init && tsc",
    "start": "node init && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "vercel-build": "prisma generate && prisma migrate deploy && npm run build",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "embedded-postgres": "^18.6.0-beta.19",
    "prisma": "6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
